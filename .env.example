# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trello?schema=public"

# Application Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173
APP_NAME="Krello Backend"
APP_GLOBAL_PREFIX=api

# Swagger API Documentation
SWAGGER_ENABLE=true
SWAGGER_PATH=api-docs
SWAGGER_SERVER_URL=http://localhost:3000

# Redis Cache & Sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT & Authentication Keys
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
REFRESH_JWT_SECRET=your_refresh_secret
REFRESH_JWT_EXPIRES_IN=7d

ACCESS_TOKEN_KEY=your_jwt_secret
ACCESS_TOKEN_EXPIRES_IN=86400
REFRESH_TOKEN_KEY=your_refresh_secret

# Third-party Services
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
GOOGLE_CLIENT_ID=your_google_client_id

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=no-reply@example.com
EMAIL_PASSWORD=your_email_password

# Firebase Admin SDK (Optional)
FB_PROJECT_ID=your_firebase_project_id
FB_CLIENT_EMAIL=your_firebase_client_email
FB_PRIVATE_KEY=your_firebase_private_key
